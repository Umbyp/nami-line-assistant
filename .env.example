# ─────────────────────────────────────────────────────────────
# นามิ (Nami) — LINE personal assistant
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug
# port ของ API (3000 มักชนกับ dev server อื่นบนเครื่อง)
PORT=3100

# ── LINE Messaging API ───────────────────────────────────────
# ได้จาก LINE Developers Console > Channel ของคุณ > Basic settings / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ปิด signature verification ได้เฉพาะตอน dev (สำหรับยิงเทสต์ด้วย curl)
# ห้ามตั้งเป็น true บน production เด็ดขาด
LINE_SKIP_SIGNATURE_VERIFY=false

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://nami:nami@localhost:55432/nami?schema=public

# ── Redis (BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible: MinIO ตอน dev / Cloudflare R2 ตอน prod) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nami-vault
S3_ACCESS_KEY_ID=nami-minio
S3_SECRET_ACCESS_KEY=nami-minio-secret
# MinIO ต้องเป็น true (path-style), R2 ตั้ง false ได้
S3_FORCE_PATH_STYLE=true

# ── Anthropic (NLU + อ่านรูป) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Embeddings สำหรับ vault semantic search (ใช้ตอน P4) ──────
# Anthropic API ไม่มี embeddings endpoint จึงใช้ Voyage AI
# ถ้าเว้นว่าง: vault จะ fallback ไปใช้ full-text (tsvector) เพียงอย่างเดียว
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

# ── Timezone ─────────────────────────────────────────────────
# เก็บใน DB เป็น UTC เสมอ / แสดงผลด้วย tz นี้เสมอ
APP_TIMEZONE=Asia/Bangkok

# ── Quiet hours เริ่มต้น (นาทีนับจากเที่ยงคืน เวลาไทย) ────────
# 1320 = 22:00, 420 = 07:00
DEFAULT_QUIET_HOURS_START=1320
DEFAULT_QUIET_HOURS_END=420

# ── Soft limit โควตา push ต่อเดือน (LINE คิดเงินค่า push) ─────
PUSH_SOFT_LIMIT_FREE=200
PUSH_SOFT_LIMIT_PRO=5000
STORAGE_SOFT_LIMIT_FREE_MB=200
STORAGE_SOFT_LIMIT_PRO_MB=5000
