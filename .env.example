# ─────────────────────────────────────────────────────────────
# นามิ (Nami) — LINE personal assistant
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug
# port ของ API (3000 มักชนกับ dev server อื่นบนเครื่อง)
PORT=3100

# ── LINE Messaging API ───────────────────────────────────────
# ได้จาก LINE Developers Console > Channel ของคุณ > Basic settings / Messaging API
LINE_CHANNEL_SECRET=3f0235ad03a7a78d76383ec4c079d903
LINE_CHANNEL_ACCESS_TOKEN=kXt08rlYoqkNhqpkL8UJ4uWPvkNSNAaD1N1OZKyV9asdMjMG/pEonn8g0bRdLSPrmBRDpv1C+eDGckLlo1j90YlRonzyczHDJwiKzr1uCOW0krhZqp2jHve/B96uFUrHQ+4I8nKN7YmBB5DWulWV8AdB04t89/1O/w1cDnyilFU=
# ปิด signature verification ได้เฉพาะตอน dev (สำหรับยิงเทสต์ด้วย curl)
# ห้ามตั้งเป็น true บน production เด็ดขาด
LINE_SKIP_SIGNATURE_VERIFY=false

# ── PostgreSQL ───────────────────────────────────────────────
# DATABASE_URL = connection ที่แอปใช้ query
# DIRECT_URL   = connection ที่ prisma migrate ใช้ (ต้องไม่ผ่าน connection pooler)
#
# dev (Postgres ใน docker compose) — ตั้งเหมือนกันทั้งสองค่าได้
DATABASE_URL=postgresql://nami:nami@localhost:55432/nami?schema=public
DIRECT_URL=postgresql://nami:nami@localhost:55432/nami?schema=public
#
# prod (Supabase) — เอามาจาก Dashboard > Project Settings > Database
#   DATABASE_URL = "Connection pooling" URI  port 6543  ต่อท้ายด้วย &pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Direct connection" URI   port 5432
# หมายเหตุ: host db.<ref>.supabase.co ของ Supabase เป็น IPv6-only
# ถ้าเน็ตที่ deploy ไม่มี IPv6 ให้ใช้ pooler แบบ session mode (port 5432 ที่ host pooler) เป็น DIRECT_URL

# ── Redis (BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible: MinIO ตอน dev / Cloudflare R2 ตอน prod) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nami-vault
S3_ACCESS_KEY_ID=nami-minio
S3_SECRET_ACCESS_KEY=nami-minio-secret
# MinIO ต้องเป็น true (path-style), R2 ตั้ง false ได้
S3_FORCE_PATH_STYLE=true

# ── OpenRouter: NLU + อ่านรูป + embeddings (provider เดียวจบ) ──
# เอา key มาจาก https://openrouter.ai/settings/keys
# แนะนำให้ตั้ง spend limit ต่อ key ไว้ด้วยที่ /settings/limits
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/nami-line-assistant
OPENROUTER_APP_NAME="Nami LINE Assistant"

# แยกโมเดลตามงาน — วัดผลจริงแล้วว่าตัวถูกอ่าน "ตาราง" ในรูปพลาด (ดู README)
#   text   ~$0.00005/ครั้ง  ใช้กับ NLU ข้อความ
#   vision ~$0.0015/รูป     ใช้กับอ่านรูปตารางเรียน/ใบนัด/ตารางเวร
LLM_MODEL_TEXT=google/gemini-2.5-flash-lite
LLM_MODEL_VISION=google/gemini-2.5-flash
LLM_MODEL_EMBED=openai/text-embedding-3-small

# ต้องตรงกับ vector(N) ใน migration ของ vault_items
# openai/text-embedding-3-small = 1536
EMBEDDING_DIMENSIONS=1536

# NLU ที่ confidence ต่ำกว่านี้ → ถามผู้ใช้กลับ ห้ามเดา
NLU_CONFIDENCE_THRESHOLD=0.6

# ── Timezone ─────────────────────────────────────────────────
# เก็บใน DB เป็น UTC เสมอ / แสดงผลด้วย tz นี้เสมอ
APP_TIMEZONE=Asia/Bangkok

# ── Quiet hours เริ่มต้น (นาทีนับจากเที่ยงคืน เวลาไทย) ────────
# 1320 = 22:00, 420 = 07:00
DEFAULT_QUIET_HOURS_START=1320
DEFAULT_QUIET_HOURS_END=420

# ── Soft limit โควตา push ต่อเดือน (LINE คิดเงินค่า push) ─────
PUSH_SOFT_LIMIT_FREE=200
PUSH_SOFT_LIMIT_PRO=5000
STORAGE_SOFT_LIMIT_FREE_MB=200
STORAGE_SOFT_LIMIT_PRO_MB=5000
