{
  "name": "nami-line-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "webhook:send": "tsx scripts/send-webhook.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "llm:bench": "tsx scripts/llm-bench.ts",
    "nlu:probe": "tsx scripts/probe-time.ts",
    "richmenu:setup": "tsx scripts/setup-richmenu.ts",
    "image:probe": "tsx scripts/probe-image.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@line/bot-sdk": "^9.9.0",
    "@prisma/client": "^6.16.1",
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "luxon": "^3.7.1",
    "openai": "^4.104.0",
    "pino": "^9.9.0",
    "rrule": "^2.8.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.1",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract": false,
    "fsevents@2.3.3": true
  }
}
